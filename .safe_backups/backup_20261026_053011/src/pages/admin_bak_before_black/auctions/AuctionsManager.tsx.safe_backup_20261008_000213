import React, { useState, useEffect, useRef } from 'react';
import { useNavigate } from 'react-router-dom';
import {
  Gavel, AlertCircle, CheckCircle2, Search,
  RefreshCw, Calendar, MapPin, Activity,
  Trash2, Edit, Plus, X, ImagePlus, ShieldCheck,
  Scale, Tag, Percent, Phone, MessageCircle, Mail, Clock,
  User, DollarSign
} from 'lucide-react';
import { adminAuctionsService } from '../../../services/adminService';
import { supabase } from '../../../lib/supabase';
import { YRSelect } from '../../../components/common/YRSelect';

const CATEGORIES = [
  'سيارات ومركبات',
  'هواتف وأجهزة ذكية',
  'أسلحة ومقتنيات شخصية',
  'عفش وأثاث',
  'عقارات وأراضي',
  'أغراض وسلع عامة'
];

const YEMEN_CITIES = [
  { value: 'all', label: 'كل المدن والمحافظات' },
  { value: 'صنعاء', label: 'صنعاء' },
  { value: 'عدن', label: 'عدن' },
  { value: 'تعز', label: 'تعز' },
  { value: 'حضرموت', label: 'حضرموت' },
  { value: 'الحديدة', label: 'الحديدة' },
  { value: 'مأرب', label: 'مأرب' },
  { value: 'إب', label: 'إب' },
  { value: 'ذمار', label: 'ذمار' }
];

export const AuctionsManager: React.FC = () => {
  const navigate = useNavigate();

  // التبويب النشط: المعروضات أو سجل المزايدات والمشترين
  const [activeTab, setActiveTab] = useState<'listings' | 'bids_log'>('listings');

  // بيانات المعروضات
  const [listings, setListings] = useState<any[]>([]);
  const [loadingListings, setLoadingListings] = useState(true);
  const [filterType, setFilterType] = useState<'all' | 'auction' | 'fixed_price'>('all');
  const [cityFilter, setCityFilter] = useState('all');
  const [searchTerm, setSearchTerm] = useState('');

  // بيانات سجل المزايدات والمشترين الحقيقي
  const [bidsLog, setBidsLog] = useState<any[]>([]);
  const [loadingBids, setLoadingBids] = useState(false);

  // إعدادات نسب العمولة الحقيقية في Supabase
  const [sellerRate, setSellerRate] = useState<number>(10);
  const [buyerRate, setBuyerRate] = useState<number>(5);
  const [defaultMinInc, setDefaultMinInc] = useState<number>(1000);
  const [savingSettings, setSavingSettings] = useState(false);
  const [settingsSuccessToast, setSettingsSuccessToast] = useState(false);

  // حالات النوافذ المنبثقة
  const [modalMode, setModalMode] = useState<'create' | 'edit' | null>(null);
  const [editingId, setEditingId] = useState<string | null>(null);
  const [deleteConfirmItem, setDeleteConfirmItem] = useState<any | null>(null);
  const [toastMsg, setToastMsg] = useState<string | null>(null);

  // حقول نموذج المزاد
  const [formTitle, setFormTitle] = useState('');
  const [formSellerName, setFormSellerName] = useState('');
  const [formSaleType, setFormSaleType] = useState<'auction' | 'fixed_price'>('auction');
  const [formCategory, setFormCategory] = useState(CATEGORIES[0]);
  const [formCity, setFormCity] = useState('صنعاء');
  const [formCurrency, setFormCurrency] = useState('SAR');
  const [formStartingPrice, setFormStartingPrice] = useState('');
  const [formMinIncrement, setFormMinIncrement] = useState('1000');
  const [formMaxIncrement, setFormMaxIncrement] = useState('');
  const [formStartTime, setFormStartTime] = useState('');
  const [formEndDate, setFormEndDate] = useState('');
  const [formPhone, setFormPhone] = useState('');
  const [formDescription, setFormDescription] = useState('');
  const [formImages, setFormImages] = useState<string[]>([]);
  const [compressing, setCompressing] = useState(false);
  const [formConsent, setFormConsent] = useState(false);
  const [submittingModal, setSubmittingModal] = useState(false);

  const fileInputRef = useRef<HTMLInputElement | null>(null);

  // جلب المعروضات
  const fetchListings = async () => {
    try {
      setLoadingListings(true);
      const { data, error } = await supabase.from('auctions').select('*').order('created_at', { ascending: false });
      if (!error && data) setListings(data);
    } catch (err) {
      console.error(err);
    } finally {
      setLoadingListings(false);
    }
  };

  // جلب سجل المزايدات والمشترين الحقيقي بالأسماء والأرقام
  const fetchBidsLog = async () => {
    try {
      setLoadingBids(true);
      const { data, error } = await supabase
        .from('auction_bids')
        .select('*')
        .order('created_at', { ascending: false })
        .limit(100);

      if (!error && data) setBidsLog(data);
    } catch (err) {
      console.error(err);
    } finally {
      setLoadingBids(false);
    }
  };

  // جلب نسب العمولات الحقيقية من قاعدة البيانات
  const fetchSettings = async () => {
    try {
      const { data } = await supabase.from('platform_commission_settings').select('*').limit(1).maybeSingle();
      if (data) {
        setSellerRate(Number(data.seller_commission_rate) || 10);
        setBuyerRate(Number(data.buyer_commission_rate) || 5);
        setDefaultMinInc(Number(data.default_min_increment) || 1000);
      }
    } catch (err) {
      console.error(err);
    }
  };

  useEffect(() => {
    fetchListings();
    fetchBidsLog();
    fetchSettings();
  }, []);

  // حفظ نسب العمولة الحقيقية في Supabase
  const handleSaveCommissionRates = async () => {
    try {
      setSavingSettings(true);
      const payload = {
        seller_commission_rate: Number(sellerRate),
        buyer_commission_rate: Number(buyerRate),
        default_min_increment: Number(defaultMinInc),
        updated_at: new Date().toISOString()
      };

      const { data: existing } = await supabase.from('platform_commission_settings').select('id').limit(1).maybeSingle();
      if (existing?.id) {
        await supabase.from('platform_commission_settings').update(payload).eq('id', existing.id);
      } else {
        await supabase.from('platform_commission_settings').insert([payload]);
      }

      setSettingsSuccessToast(true);
      setTimeout(() => setSettingsSuccessToast(false), 3500);
    } catch (err: any) {
      alert('خطأ في حفظ النسبة: ' + err.message);
    } finally {
      setSavingSettings(false);
    }
  };

  // ضغط الصور التلقائي
  const compressImage = (file: File): Promise<string> => {
    return new Promise((resolve) => {
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new window.Image();
        img.onload = () => {
          const canvas = document.createElement('canvas');
          const maxDim = 1000;
          let width = img.width;
          let height = img.height;
          if (width > height && width > maxDim) {
            height = Math.round((height * maxDim) / width);
            width = maxDim;
          } else if (height > maxDim) {
            width = Math.round((width * maxDim) / height);
            height = maxDim;
          }
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          ctx?.drawImage(img, 0, 0, width, height);
          resolve(canvas.toDataURL('image/jpeg', 0.72));
        };
        img.src = e.target?.result as string;
      };
      reader.readAsDataURL(file);
    });
  };

  const handleImagesUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const files = e.target.files;
    if (!files || files.length === 0) return;
    const remaining = 6 - formImages.length;
    if (remaining <= 0) return;
    try {
      setCompressing(true);
      const toProcess = Array.from(files).slice(0, remaining);
      const list: string[] = [];
      for (const file of toProcess) {
        const c = await compressImage(file);
        list.push(c);
      }
      setFormImages((prev) => [...prev, ...list]);
    } catch (err) {
      console.error(err);
    } finally {
      setCompressing(false);
    }
  };

  const openCreateModal = () => {
    setModalMode('create');
    setEditingId(null);
    setFormTitle('');
    setFormSellerName('');
    setFormSaleType('auction');
    setFormCategory(CATEGORIES[0]);
    setFormCity('صنعاء');
    setFormCurrency('SAR');
    setFormStartingPrice('');
    setFormMinIncrement(String(defaultMinInc || 1000));
    setFormMaxIncrement('');
    const now = new Date();
    setFormStartTime(now.toISOString().slice(0, 16));
    const end = new Date(now.getTime() + 3 * 24 * 60 * 60 * 1000);
    setFormEndDate(end.toISOString().slice(0, 16));
    setFormPhone('');
    setFormDescription('');
    setFormImages([]);
    setFormConsent(false);
  };

  const openEditModal = (item: any) => {
    setModalMode('edit');
    setEditingId(item.id);
    setFormTitle(item.title || '');
    setFormSellerName(item.seller_name || item.sellerName || '');
    setFormSaleType(item.sale_type || 'auction');
    setFormCategory(item.category || CATEGORIES[0]);
    setFormCity(item.city || 'صنعاء');
    setFormCurrency(item.currency || 'SAR');
    setFormStartingPrice(String(item.starting_price || item.current_bid || ''));
    setFormMinIncrement(String(item.min_increment || defaultMinInc || 1000));
    setFormMaxIncrement(String(item.max_increment || ''));
    setFormStartTime(item.start_time ? new Date(item.start_time).toISOString().slice(0, 16) : '');
    setFormEndDate(item.end_date ? new Date(item.end_date).toISOString().slice(0, 16) : '');
    setFormPhone(item.seller_phone || '');
    setFormDescription(item.description || '');
    const imgs = Array.isArray(item.images) ? item.images : (item.image_url ? [item.image_url] : []);
    setFormImages(imgs);
    setFormConsent(true);
  };

  const handleSaveModal = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!formTitle.trim() || formPhone.length !== 9) {
      setToastMsg('يرجى كتابة العنوان وإدخال رقم هاتف مكون من 9 أرقام');
      setTimeout(() => setToastMsg(null), 3500);
      return;
    }

    try {
      setSubmittingModal(true);
      const priceNum = parseFloat(formStartingPrice) || 0;
      const minInc = parseFloat(formMinIncrement) || 1000;
      const maxInc = formMaxIncrement ? parseFloat(formMaxIncrement) : null;

      const payload: any = {
        title: formTitle.trim(),
        seller_name: formSellerName.trim() || 'صاحب المعروض المعتمد',
        sale_type: formSaleType,
        category: formCategory,
        city: formCity,
        currency: formCurrency,
        starting_price: priceNum,
        min_increment: minInc,
        max_increment: maxInc,
        start_time: formStartTime ? new Date(formStartTime).toISOString() : new Date().toISOString(),
        end_date: formEndDate ? new Date(formEndDate).toISOString() : new Date(Date.now() + 3 * 24 * 3600 * 1000).toISOString(),
        seller_phone: formPhone,
        description: formDescription.trim(),
        images: formImages
      };

      if (modalMode === 'create') {
        payload.current_bid = priceNum;
        payload.status = 'active';
        payload.created_at = new Date().toISOString();
        const { error } = await supabase.from('auctions').insert([payload]);
        if (error) throw error;
        setToastMsg('تم نشر المعروض بنجاح');
      } else if (modalMode === 'edit' && editingId) {
        const { error } = await supabase.from('auctions').update(payload).eq('id', editingId);
        if (error) throw error;
        setToastMsg('تم حفظ وتحديث بيانات المعروض بنجاح');
      }

      setModalMode(null);
      setTimeout(() => setToastMsg(null), 3500);
      fetchListings();
    } catch (err: any) {
      setToastMsg(err.message || 'حدث خطأ أثناء الحفظ');
      setTimeout(() => setToastMsg(null), 3500);
    } finally {
      setSubmittingModal(false);
    }
  };

  const handleDeleteItem = async () => {
    if (!deleteConfirmItem) return;
    try {
      const { error } = await supabase.from('auctions').delete().eq('id', deleteConfirmItem.id);
      if (error) throw error;
      setListings((prev) => prev.filter((i) => i.id !== deleteConfirmItem.id));
      setDeleteConfirmItem(null);
      setToastMsg('تم حذف المعروض بنجاح');
      setTimeout(() => setToastMsg(null), 3500);
    } catch (err: any) {
      setToastMsg(err.message || 'تعذر الحذف');
      setTimeout(() => setToastMsg(null), 3500);
    }
  };

  const filteredListings = listings.filter((item) => {
    if (filterType !== 'all' && item.sale_type !== filterType) return false;
    if (cityFilter !== 'all' && (!item.city || !item.city.includes(cityFilter))) return false;
    if (searchTerm.trim() && !item.title.toLowerCase().includes(searchTerm.toLowerCase())) return false;
    return true;
  });

  const activeCount = listings.filter((l) => l.status === 'active' && l.sale_type !== 'fixed_price').length;
  const directCount = listings.filter((l) => l.sale_type === 'fixed_price').length;
  const completedCount = listings.filter((l) => l.status === 'completed' || l.status === 'ended').length;

  return (
    <div dir="rtl" className="max-w-7xl mx-auto px-3 sm:px-4 py-4 space-y-4 font-['Cairo'] text-white">
      {/* التنبيهات المنبثقة */}
      {toastMsg && (
        <div className="fixed top-5 left-1/2 -translate-x-1/2 z-50 bg-[#F5C400] text-black px-5 py-2.5 rounded-xl font-black text-xs shadow-2xl flex items-center gap-2 border border-black/10 animate-bounce">
          <CheckCircle2 size={16} />
          <span>{toastMsg}</span>
        </div>
      )}

      {/* الترويسة الرئيسية */}
      <div className="flex flex-wrap items-center justify-between gap-3 bg-[#0A0F1D] border border-slate-800 p-4 rounded-2xl">
        <div className="flex items-center gap-3">
          <div className="w-10 h-10 rounded-xl bg-[#060A13] border border-[#F5C400]/40 flex items-center justify-center text-[#F5C400]">
            <Gavel size={22} />
          </div>
          <div>
            <h1 className="text-lg sm:text-xl font-black text-white">إدارة المزادات</h1>
            <p className="text-xs text-slate-400 mt-0.5">منصة يمن ريتنج - بيانات حقيقية، أرقام تواصل للمشترين، وتعديل العمولات</p>
          </div>
        </div>

        <div className="flex items-center gap-2">
          <button
            onClick={openCreateModal}
            className="inline-flex items-center gap-1.5 px-4 py-2.5 bg-[#F5C400] hover:bg-[#DDAF00] text-black font-black rounded-xl text-xs sm:text-sm shadow-md transition-all active:scale-95 cursor-pointer"
          >
            <Plus size={16} />
            <span>+ إضافة معروض جديد</span>
          </button>
          <button
            onClick={() => { fetchListings(); fetchBidsLog(); }}
            className="p-2.5 bg-[#060A13] border border-slate-800 rounded-xl text-slate-300 hover:text-white transition-colors cursor-pointer"
            title="تحديث البيانات"
          >
            <RefreshCw size={15} className={loadingListings || loadingBids ? 'animate-spin text-[#F5C400]' : ''} />
          </button>
        </div>
      </div>

      {/* لوحة العرض (KPIs) */}
      <div className="grid grid-cols-2 lg:grid-cols-4 gap-3">
        <div className="p-4 rounded-2xl bg-[#0A0F1D] border border-slate-800 space-y-1">
          <span className="text-slate-400 text-xs font-bold block">إجمالي المعروضات</span>
          <div className="text-2xl font-black text-white font-mono">{listings.length}</div>
          <span className="text-[10px] text-slate-500 block">معروض مسجل في قاعدة البيانات</span>
        </div>

        <div className="p-4 rounded-2xl bg-[#0A0F1D] border border-slate-800 space-y-1">
          <span className="text-slate-400 text-xs font-bold block">المزادات النشطة</span>
          <div className="text-2xl font-black text-[#F5C400] font-mono">{activeCount}</div>
          <span className="text-[10px] text-emerald-400 block">متاحة للمزايدة حالياً</span>
        </div>

        <div className="p-4 rounded-2xl bg-[#0A0F1D] border border-slate-800 space-y-1">
          <span className="text-slate-400 text-xs font-bold block">سجل المشتركين</span>
          <div className="text-2xl font-black text-emerald-400 font-mono">{bidsLog.length}</div>
          <span className="text-[10px] text-emerald-300 block">عملية مسجلة بأرقام التواصل</span>
        </div>

        <div className="p-4 rounded-2xl bg-[#0A0F1D] border border-slate-800 space-y-1">
          <span className="text-slate-400 text-xs font-bold block">المزادات المكتملة</span>
          <div className="text-2xl font-black text-slate-300 font-mono">{completedCount}</div>
          <span className="text-[10px] text-slate-500 block">صفقات منتهية ورست</span>
        </div>
      </div>

      {/* شريط التحكم في نسبة العمولة الحقيقي المتصل بـ Supabase */}
      <div className="bg-[#0A0F1D] border border-amber-500/40 rounded-2xl p-4 space-y-3 shadow-lg">
        <div className="flex items-center justify-between border-b border-slate-800 pb-2.5">
          <div className="flex items-center gap-2">
            <Percent size={18} className="text-[#F5C400]" />
            <h3 className="text-sm font-black text-white">إعدادات العمولة</h3>
          </div>
          <button
            type="button"
            onClick={handleSaveCommissionRates}
            disabled={savingSettings}
            className="shrink-0 px-4 py-2 bg-[#F5C400] hover:bg-[#DDAF00] text-black font-black text-xs rounded-xl shadow-md transition-all active:scale-95 cursor-pointer flex items-center gap-1.5"
          >
            <CheckCircle2 size={15} />
            <span>{savingSettings ? 'جاري الحفظ...' : 'حفظ'}</span>
          </button>
        </div>

        {settingsSuccessToast && (
          <div className="p-2.5 rounded-xl bg-emerald-950 text-emerald-300 border border-emerald-500/50 text-xs font-bold flex items-center gap-2">
            <CheckCircle2 size={15} />
            <span>تم حفظ إعدادات العمولة بنجاح</span>
          </div>
        )}

        <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
          <div>
            <label className="text-slate-300 block mb-1 font-bold">نسبة عمولة البائع (%):</label>
            <input
              type="number"
              value={sellerRate}
              onChange={(e) => setSellerRate(Number(e.target.value))}
              className="w-full bg-[#060A13] border border-slate-800 focus:border-[#F5C400] rounded-xl p-2.5 text-white font-mono font-bold outline-none"
            />
          </div>

          <div>
            <label className="text-slate-300 block mb-1 font-bold">نسبة عمولة المشتري (%):</label>
            <input
              type="number"
              value={buyerRate}
              onChange={(e) => setBuyerRate(Number(e.target.value))}
              className="w-full bg-[#060A13] border border-slate-800 focus:border-[#F5C400] rounded-xl p-2.5 text-white font-mono font-bold outline-none"
            />
          </div>

          <div>
            <label className="text-slate-300 block mb-1 font-bold">أدنى قفزة للمزايدة (الافتراضية):</label>
            <input
              type="number"
              value={defaultMinInc}
              onChange={(e) => setDefaultMinInc(Number(e.target.value))}
              className="w-full bg-[#060A13] border border-slate-800 focus:border-[#F5C400] rounded-xl p-2.5 text-white font-mono font-bold outline-none"
            />
          </div>
        </div>
      </div>

      {/* التبديل بين جدول المعروضات وسجل المزايدات والمشترين */}
      <div className="flex items-center gap-2 bg-[#0A0F1D] p-1.5 rounded-2xl border border-slate-800">
        <button
          onClick={() => setActiveTab('listings')}
          className={`flex-1 py-2.5 rounded-xl text-xs font-black transition-all cursor-pointer ${
            activeTab === 'listings' ? 'bg-[#F5C400] text-black shadow-md' : 'text-slate-400 hover:text-white'
          }`}
        >
          المعروضات والمزادات ({listings.length})
        </button>

        <button
          onClick={() => { setActiveTab('bids_log'); fetchBidsLog(); }}
          className={`flex-1 py-2.5 rounded-xl text-xs font-black transition-all cursor-pointer flex items-center justify-center gap-2 ${
            activeTab === 'bids_log' ? 'bg-[#F5C400] text-black shadow-md' : 'text-slate-400 hover:text-white'
          }`}
        >
          <User size={15} />
          <span>سجل المشتركين ({bidsLog.length})</span>
        </button>
      </div>

      {/* 1. جدول المعروضات */}
      {activeTab === 'listings' && (
        <div className="space-y-4">
          <div className="bg-[#0A0F1D] p-3 rounded-2xl border border-slate-800 grid grid-cols-1 sm:grid-cols-4 gap-2.5">
            <div className="relative sm:col-span-2">
              <input
                type="text"
                value={searchTerm}
                onChange={(e) => setSearchTerm(e.target.value)}
                placeholder="ابحث بالعنوان أو السلعة..."
                className="w-full bg-[#060A13] border border-slate-800 focus:border-[#F5C400] rounded-xl py-2 pr-9 pl-3 text-xs text-white outline-none"
              />
              <Search className="absolute right-3 top-2.5 w-3.5 h-3.5 text-slate-400" />
            </div>

            <div>
              <select
                value={filterType}
                onChange={(e: any) => setFilterType(e.target.value)}
                className="w-full bg-[#060A13] border border-slate-800 focus:border-[#F5C400] rounded-xl p-2 text-xs text-white outline-none"
              >
                <option value="all">كل أنواع البيع</option>
                <option value="auction">مزاد علني فقط</option>
                <option value="fixed_price">بيع مباشر بسعر محدد</option>
              </select>
            </div>

            <div>
              <YRSelect
                value={cityFilter}
                options={YEMEN_CITIES}
                onChange={(v) => setCityFilter(v)}
                placeholder="كل المحافظات"
              />
            </div>
          </div>

          <div className="bg-[#0A0F1D] border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
            {loadingListings ? (
              <div className="p-16 text-center text-slate-400 space-y-2">
                <RefreshCw size={24} className="animate-spin text-[#F5C400] mx-auto" />
                <span className="text-xs font-bold block">جاري تحميل المعروضات...</span>
              </div>
            ) : filteredListings.length === 0 ? (
              <div className="p-16 text-center text-slate-400 space-y-2">
                <AlertCircle size={36} className="text-[#F5C400] mx-auto opacity-70" />
                <span className="text-sm font-bold text-white block">لا توجد معروضات مسجلة</span>
              </div>
            ) : (
              <div className="overflow-x-auto">
                <table className="w-full text-right text-xs">
                  <thead className="bg-[#060A13] text-slate-400 border-b border-slate-800 font-bold">
