                </label>
              </div>

              <div className="flex justify-end gap-2 pt-2 border-t border-slate-800">
                <button
                  type="button"
                  onClick={() => setModalMode(null)}
                  className="px-4 py-2 bg-[#060A13] rounded-xl text-slate-300"
                >
                  إلغاء
                </button>
                <button
                  type="submit"
                  disabled={!formConsent || submittingModal || compressing}
                  className="px-6 py-2 bg-[#F5C400] text-black font-black rounded-xl cursor-pointer"
                >
                  {submittingModal ? 'جاري الحفظ...' : (modalMode === 'create' ? 'نشر المعروض الآن' : 'حفظ التعديلات')}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* نافذة تأكيد الحذف */}
      {deleteConfirmItem && (
        <div className="fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-4">
          <div className="bg-[#0A0F1D] border border-rose-500/50 rounded-2xl w-full max-w-sm p-5 space-y-4 text-white text-center shadow-2xl">
            <Trash2 size={40} className="text-rose-500 mx-auto" />
            <h4 className="text-sm font-black text-white">تأكيد حذف المعروض نهائياً</h4>
            <p className="text-xs text-slate-300">
              هل أنت متأكد من حذف ({deleteConfirmItem.title}) نهائياً من قاعدة البيانات؟ لا يمكن التراجع عن هذا الإجراء.
            </p>
            <div className="flex justify-center gap-2 pt-2">
              <button
                type="button"
                onClick={() => setDeleteConfirmItem(null)}
                className="px-4 py-2 bg-[#060A13] border border-slate-800 rounded-xl text-slate-300 text-xs"
              >
                إلغاء
              </button>
              <button
                type="button"
                onClick={handleDeleteItem}
                className="px-5 py-2 bg-rose-600 hover:bg-rose-500 text-white font-black text-xs rounded-xl cursor-pointer"
              >
                تأكيد الحذف
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default AuctionsManager;
