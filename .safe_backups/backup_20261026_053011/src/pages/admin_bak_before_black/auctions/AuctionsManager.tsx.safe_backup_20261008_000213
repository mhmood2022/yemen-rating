              <div>
                <div className="flex items-center justify-between mb-1">
                  <span className="font-bold text-slate-300">صور المعروض (1 إلى 6 صور):</span>
                  <span className="text-[#F5C400] font-bold">{formImages.length} من 6</span>
                </div>
                <input type="file" accept="image/*" multiple ref={fileInputRef} onChange={handleImagesUpload} className="hidden" />
                <button
