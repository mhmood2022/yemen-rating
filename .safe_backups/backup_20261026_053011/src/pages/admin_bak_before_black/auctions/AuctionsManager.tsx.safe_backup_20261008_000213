                  className="w-full py-2.5 border border-dashed border-slate-700 hover:border-[#F5C400] rounded-xl bg-[#060A13] text-slate-300 flex items-center justify-center gap-2 cursor-pointer"
                >
                  <ImagePlus size={15} className="text-[#F5C400]" />
                  <span>{compressing ? 'جاري ضغط الصور...' : 'اضغط لاختيار الصور من استوديو الجوال'}</span>
