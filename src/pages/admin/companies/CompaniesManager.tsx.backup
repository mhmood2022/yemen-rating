import React, { useState, useEffect, useMemo } from 'react';
import { useSearchParams } from 'react-router-dom';
import { supabase } from '../../../lib/supabase';
import { OFFICIAL_CATEGORIES, CategoryItem } from '../../../data/categories';
import {
  Building2, Search, Plus, Check, Filter, X, ShieldAlert,
  EyeOff, Eye, Edit3, Upload, Trash2, Phone, Globe, Mail,
  MapPin, CheckCircle2, Loader2, Award, ExternalLink
} from 'lucide-react';

interface BusinessRecord {
  id: string;
  name: string;
  slug: string;
  category_id: string;
  description: string | null;
  phone: string | null;
  whatsapp: string | null;
  email: string | null;
  website_url: string | null;
  city: string;
  address: string | null;
  logo_url: string | null;
  cover_url: string | null;
  badge_type: 'gold' | 'blue' | 'gray' | null;
  is_verified: boolean;
  status: 'active' | 'hidden' | 'pending';
  claim_status: 'UNCLAIMED' | 'PENDING' | 'CLAIMED';
  rating?: number;
  review_count?: number;
  created_at?: string;
  category_name?: string;
  category_slug?: string;
}

export const CompaniesManager: React.FC = () => {
  const [searchParams, setSearchParams] = useSearchParams();
  const currentCategorySlug = searchParams.get('category');

  const [businesses, setBusinesses] = useState<BusinessRecord[]>([]);
  const [categoriesMap, setCategoriesMap] = useState<Record<string, { id: string; name: string; slug: string }>>({});
  const [loading, setLoading] = useState(true);
  const [searchTerm, setSearchTerm] = useState('');
  const [filterCity, setFilterCity] = useState('all');
  const [filterBadge, setFilterBadge] = useState('all');

  // نافذة الإضافة والتعديل
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [editingId, setEditingId] = useState<string | null>(null);
  const [saving, setSaving] = useState(false);
  const [uploadingTarget, setUploadingTarget] = useState<'logo' | 'cover' | null>(null);
  const [errorMessage, setErrorMessage] = useState<string | null>(null);

  // حقول النموذج
  const [formData, setFormData] = useState<{
    name: string;
    slug: string;
    category_id: string;
    city: string;
    address: string;
    phone: string;
    whatsapp: string;
    email: string;
    website_url: string;
    description: string;
    logo_url: string | null;
    cover_url: string | null;
    badge_type: 'gold' | 'blue' | 'gray' | null;
    is_verified: boolean;
    status: 'active' | 'hidden';
    claim_status: 'UNCLAIMED' | 'PENDING' | 'CLAIMED';
  }>({
    name: '',
    slug: '',
    category_id: '',
    city: 'صنعاء',
    address: '',
    phone: '',
    whatsapp: '',
    email: '',
    website_url: '',
    description: '',
    logo_url: null,
    cover_url: null,
    badge_type: 'gold',
    is_verified: true,
    status: 'active',
    claim_status: 'UNCLAIMED',
  });

  // العثور على التصنيف المختار حالياً
  const activeOfficialCategory = useMemo(() => {
    if (!currentCategorySlug) return null;
    return OFFICIAL_CATEGORIES.find(c => c.slug === currentCategorySlug) || null;
  }, [currentCategorySlug]);

  // جلب التصنيفات والمنشآت من Supabase
  const fetchData = async () => {
    setLoading(true);
    try {
      // 1. جلب التصنيفات
      const { data: catData } = await supabase.from('categories').select('id, name, slug');
      const catMap: Record<string, { id: string; name: string; slug: string }> = {};
      if (catData) {
        catData.forEach(c => {
          catMap[c.id] = c;
          catMap[c.slug] = c;
        });
        setCategoriesMap(catMap);
      }

      // 2. جلب المنشآت الحقيقية
      const { data: bData, error } = await supabase
        .from('businesses')
        .select('*')
        .order('created_at', { ascending: false });

      if (error) throw error;

      const enriched: BusinessRecord[] = (bData || []).map(b => ({
        ...b,
        category_name: catMap[b.category_id]?.name || 'عام',
        category_slug: catMap[b.category_id]?.slug || '',
      }));

      setBusinesses(enriched);
    } catch (err: any) {
      console.error('Error fetching businesses:', err);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
  }, []);

  // تصفية المنشآت
  const filteredBusinesses = useMemo(() => {
    return businesses.filter(b => {
      // تصفية حسب التصنيف المحدد في الرابط
      if (currentCategorySlug) {
        const matchesSlug = b.category_slug === currentCategorySlug;
        const matchesId = categoriesMap[currentCategorySlug]?.id === b.category_id;
        if (!matchesSlug && !matchesId) return false;
      }
      // تصفية بالبحث
      if (searchTerm.trim()) {
        const term = searchTerm.toLowerCase();
        const matchesSearch =
          b.name.toLowerCase().includes(term) ||
          (b.city && b.city.toLowerCase().includes(term)) ||
          (b.phone && b.phone.includes(term));
        if (!matchesSearch) return false;
      }
      // تصفية بالمدينة
      if (filterCity !== 'all' && b.city !== filterCity) return false;
      // تصفية بالشارة
      if (filterBadge !== 'all') {
        if (filterBadge === 'none' && b.badge_type) return false;
        if (filterBadge !== 'none' && b.badge_type !== filterBadge) return false;
      }
      return true;
    });
  }, [businesses, currentCategorySlug, searchTerm, filterCity, filterBadge, categoriesMap]);

  // رفع الصور إلى Supabase Storage (نفس دالة البنوك)
  const handleUploadImage = async (type: 'logo' | 'cover', e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    setUploadingTarget(type);
    setErrorMessage(null);

    try {
      const ext = file.name.split('.').pop();
      const folder = type === 'logo' ? 'logos' : 'covers';
      const fileName = `${folder}/${Date.now()}_${Math.random().toString(36).substring(7)}.${ext}`;

      const { error: uploadErr } = await supabase.storage
        .from('businesses')
        .upload(fileName, file, { upsert: true });

      if (uploadErr) {
        // Fallback: رفع على مستوى الدلو العام
        await supabase.storage.from('public').upload(fileName, file, { upsert: true });
      }

      const { data: { publicUrl } } = supabase.storage
        .from('businesses')
        .getPublicUrl(fileName);

      setFormData(prev => ({
        ...prev,
        [type === 'logo' ? 'logo_url' : 'cover_url']: publicUrl || URL.createObjectURL(file)
      }));
    } catch (err: any) {
      console.warn('Direct upload notice:', err);
      // استخدام رابط معاينة كبديل إن لم تتوفر صلاحية التخزين
      const previewUrl = URL.createObjectURL(file);
      setFormData(prev => ({
        ...prev,
        [type === 'logo' ? 'logo_url' : 'cover_url']: previewUrl
      }));
    } finally {
      setUploadingTarget(null);
    }
  };

  // فتح نافذة الإضافة
  const handleOpenAddModal = () => {
    setEditingId(null);
    setErrorMessage(null);
    // إذا كنا في تصنيف محدد مسبقاً، نختاره تلقائياً
    const defaultCatId = currentCategorySlug && categoriesMap[currentCategorySlug]
      ? categoriesMap[currentCategorySlug].id
      : (Object.values(categoriesMap)[0]?.id || '');

    setFormData({
      name: '',
      slug: '',
      category_id: defaultCatId,
      city: 'صنعاء',
      address: '',
      phone: '',
      whatsapp: '',
      email: '',
      website_url: '',
      description: '',
      logo_url: null,
      cover_url: null,
      badge_type: 'gold',
      is_verified: true,
      status: 'active',
      claim_status: 'UNCLAIMED',
    });
    setIsModalOpen(true);
  };

  // فتح نافذة التعديل
  const handleOpenEditModal = (b: BusinessRecord) => {
    setEditingId(b.id);
    setErrorMessage(null);
    setFormData({
      name: b.name,
      slug: b.slug || '',
      category_id: b.category_id || '',
      city: b.city || 'صنعاء',
      address: b.address || '',
      phone: b.phone || '',
      whatsapp: b.whatsapp || '',
      email: b.email || '',
      website_url: b.website_url || '',
      description: b.description || '',
      logo_url: b.logo_url || null,
      cover_url: b.cover_url || null,
      badge_type: b.badge_type || null,
      is_verified: b.is_verified,
      status: b.status === 'hidden' ? 'hidden' : 'active',
      claim_status: b.claim_status || 'UNCLAIMED',
    });
    setIsModalOpen(true);
  };

  // حفظ المنشأة (إضافة أو تعديل)
  const handleSaveBusiness = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!formData.name.trim()) {
      setErrorMessage('يرجى كتابة اسم المنشأة.');
      return;
    }

    setSaving(true);
    setErrorMessage(null);

    const generatedSlug = formData.slug.trim() || formData.name.trim().toLowerCase().replace(/\s+/g, '-');

    const payload = {
      name: formData.name.trim(),
      slug: generatedSlug,
      category_id: formData.category_id,
      city: formData.city,
      address: formData.address || null,
      phone: formData.phone || null,
      whatsapp: formData.whatsapp || null,
      email: formData.email || null,
      website_url: formData.website_url || null,
      description: formData.description || null,
      logo_url: formData.logo_url,
      cover_url: formData.cover_url,
      badge_type: formData.badge_type,
      is_verified: formData.is_verified,
      status: formData.status,
      claim_status: formData.claim_status,
      updated_at: new Date().toISOString(),
    };

    try {
      if (editingId) {
        // تحديث منشأة حالية
        const { error } = await supabase
          .from('businesses')
          .update(payload)
          .eq('id', editingId);
        if (error) throw error;
      } else {
        // إضافة منشأة جديدة
        const { error } = await supabase
          .from('businesses')
          .insert([{ ...payload, created_at: new Date().toISOString() }]);
        if (error) throw error;
      }

      await fetchData();
      setIsModalOpen(false);
    } catch (err: any) {
      console.error('Error saving business:', err);
      setErrorMessage(err.message || 'حدث خطأ أثناء حفظ البيانات.');
    } finally {
      setSaving(false);
    }
  };

  // تبديل حالة الإخفاء أو الحذف
  const handleToggleStatus = async (b: BusinessRecord) => {
    const nextStatus = b.status === 'hidden' ? 'active' : 'hidden';
    try {
      await supabase.from('businesses').update({ status: nextStatus }).eq('id', b.id);
      setBusinesses(prev => prev.map(item => item.id === b.id ? { ...item, status: nextStatus } : item));
    } catch (err) {
      console.error('Status toggle error:', err);
    }
  };

  return (
    <div dir="rtl" className="p-4 sm:p-6 lg:p-8 space-y-6 font-['Cairo',sans-serif] text-white">
      {/* رأس الصفحة الديناميكي */}
      <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-4 border-b border-[#1F2937]">
        <div>
          <div className="flex items-center gap-2.5">
            {activeOfficialCategory && (
              <div className="w-10 h-10 rounded-xl bg-yellow-500/10 flex items-center justify-center text-yellow-400">
                <activeOfficialCategory.icon className="w-5 h-5" />
              </div>
            )}
            <div>
              <h1 className="text-xl sm:text-2xl font-black text-white">
                {activeOfficialCategory ? `إدارة ${activeOfficialCategory.name}` : 'إدارة كافة المنشآت والأنشطة'}
              </h1>
              <p className="text-xs text-gray-400 mt-1">
                {activeOfficialCategory
                  ? `التحكم في ${activeOfficialCategory.name} المسجلة في الموقع، رفع الشعارات، وتعديل الشارات الملكية.`
                  : 'إدارة وتعديل منشآت اليمن المعتمدة والمطالبة بالملكية.'}
              </p>
            </div>
          </div>
        </div>

        <div className="flex items-center gap-3 w-full sm:w-auto">
          {currentCategorySlug && (
            <button
              onClick={() => setSearchParams({})}
              className="px-3 py-2 rounded-xl bg-[#161D2B] border border-[#1F2937] text-xs text-gray-300 hover:text-white transition-colors"
            >
              عرض كافة التصنيفات
            </button>
          )}
          <button
            onClick={handleOpenAddModal}
            className="flex-1 sm:flex-none flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-[#FFC500] hover:bg-[#e6b200] text-black font-bold text-xs shadow-lg transition-all"
          >
            <Plus size={16} />
            إضافة {activeOfficialCategory ? activeOfficialCategory.name.replace(/ال/, '') : 'منشأة'} جديدة
          </button>
        </div>
      </div>

      {/* شريط الفلاتر والبحث */}
      <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 bg-[#0B0F17] p-3 rounded-2xl border border-[#1F2937]">
        <div className="relative">
          <Search size={16} className="absolute right-3.5 top-3.5 text-gray-400" />
          <input
            type="text"
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            placeholder="ابحث بالاسم، المدينة، الهاتف..."
            className="w-full pr-10 pl-3 py-2 bg-[#161D2B] border border-[#1F2937] rounded-xl text-xs text-white placeholder-gray-500 outline-none focus:border-[#FFC500]/50"
          />
        </div>

        <select
          value={filterCity}
          onChange={(e) => setFilterCity(e.target.value)}
          className="bg-[#161D2B] border border-[#1F2937] rounded-xl px-3 py-2 text-xs text-gray-300 outline-none"
        >
          <option value="all">كافة المدن والمحافظات</option>
          <option value="صنعاء">صنعاء</option>
          <option value="عدن">عدن</option>
          <option value="تعز">تعز</option>
          <option value="حضرموت">حضرموت</option>
          <option value="إب">إب</option>
          <option value="الحديدة">الحديدة</option>
          <option value="ذمار">ذمار</option>
        </select>

        <select
          value={filterBadge}
          onChange={(e) => setFilterBadge(e.target.value)}
          className="bg-[#161D2B] border border-[#1F2937] rounded-xl px-3 py-2 text-xs text-gray-300 outline-none"
        >
          <option value="all">كافة الشارات</option>
          <option value="gold">شارة ذهبية (Gold)</option>
          <option value="blue">شارة موثقة (Blue)</option>
          <option value="gray">شارة فضية (Gray)</option>
          <option value="none">بدون شارة</option>
        </select>
      </div>

      {/* قائمة البطاقات الحقيقية */}
      {loading ? (
        <div className="py-20 text-center text-xs text-gray-400 flex flex-col items-center justify-center gap-2">
          <Loader2 className="w-6 h-6 animate-spin text-[#FFC500]" />
          جاري جلب المنشآت الحقيقية من Supabase...
        </div>
      ) : filteredBusinesses.length === 0 ? (
        <div className="py-16 text-center bg-[#0B0F17] rounded-2xl border border-dashed border-[#1F2937] space-y-3">
          <Building2 className="w-10 h-10 text-gray-600 mx-auto" />
          <p className="text-sm font-bold text-gray-300">
            {activeOfficialCategory
              ? `لا توجد ${activeOfficialCategory.name} مسجلة حالياً (0 مسجل)`
              : 'لا توجد منشآت مطابقة للبحث'}
          </p>
          <p className="text-xs text-gray-500 max-w-sm mx-auto">
            يمكنك الآن إضافة أول {activeOfficialCategory ? activeOfficialCategory.name.replace(/ال/, '') : 'منشأة'} ورفع شعارها وشارتها لتظهر فوراً في الموقع العام.
          </p>
          <button
            onClick={handleOpenAddModal}
            className="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#FFC500] text-black font-bold text-xs"
          >
            <Plus size={14} /> إضافة الآن
          </button>
        </div>
      ) : (
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {filteredBusinesses.map((b) => (
            <div
              key={b.id}
              className={`bg-[#0B0F17] border rounded-2xl p-4 space-y-3.5 transition-all shadow-md ${
                b.status === 'hidden'
                  ? 'border-red-900/40 opacity-70 bg-red-950/10'
                  : 'border-[#1F2937] hover:border-[#FFC500]/50'
              }`}
            >
              {/* ترويسة البطاقة */}
              <div className="flex items-start justify-between gap-3">
                <div className="flex items-center gap-3">
                  <div className="w-12 h-12 rounded-xl bg-[#161D2B] border border-[#1F2937] flex items-center justify-center overflow-hidden shrink-0">
                    {b.logo_url ? (
                      <img src={b.logo_url} alt={b.name} className="w-full h-full object-cover" />
                    ) : (
                      <Building2 className="w-6 h-6 text-[#FFC500]" />
                    )}
                  </div>
                  <div>
                    <h3 className="font-bold text-sm text-white leading-tight">{b.name}</h3>
                    <div className="flex items-center gap-2 mt-1 text-[11px] text-gray-400">
                      <span className="flex items-center gap-1">
                        <MapPin size={11} className="text-gray-500" /> {b.city}
                      </span>
                      <span>•</span>
                      <span className="text-gray-400">{b.category_name}</span>
                    </div>
                  </div>
                </div>

                {/* الشارة */}
                {b.badge_type && (
                  <span className={`px-2 py-0.5 rounded-lg text-[10px] font-black uppercase shrink-0 ${
                    b.badge_type === 'gold'
                      ? 'bg-amber-500/20 text-amber-400 border border-amber-500/30'
                      : b.badge_type === 'blue'
                      ? 'bg-blue-500/20 text-blue-400 border border-blue-500/30'
                      : 'bg-zinc-700 text-zinc-300'
                  }`}>
                    {b.badge_type === 'gold' ? 'شارة ذهبية' : b.badge_type === 'blue' ? 'موثق رسمي' : 'شارة فضية'}
                  </span>
                )}
              </div>

              {/* أرقام التواصل والتفاصيل */}
              <div className="p-2.5 rounded-xl bg-[#161D2B]/60 border border-[#1F2937] space-y-1.5 text-xs text-gray-300">
                {b.phone && (
                  <div className="flex items-center justify-between">
                    <span className="text-gray-500 text-[11px]">الهاتف:</span>
                    <span className="font-mono text-gray-200">{b.phone}</span>
                  </div>
                )}
                {b.address && (
                  <div className="flex items-center justify-between truncate">
                    <span className="text-gray-500 text-[11px]">العنوان:</span>
                    <span className="truncate text-gray-300 text-[11px] max-w-[180px]">{b.address}</span>
                  </div>
                )}
                <div className="flex items-center justify-between pt-1 border-t border-[#1F2937]/50">
                  <span className="text-gray-500 text-[11px]">حالة الملكية:</span>
                  <span className={`text-[10px] font-bold ${
                    b.claim_status === 'CLAIMED' ? 'text-emerald-400' : 'text-amber-400'
                  }`}>
                    {b.claim_status === 'CLAIMED' ? 'تم استلام الإدارة' : 'جاهزة للتوثيق (غير مطالب بها)'}
                  </span>
                </div>
              </div>

              {/* أزرار الإجراءات */}
              <div className="flex items-center gap-2 pt-1 border-t border-[#1F2937]">
                <button
                  onClick={() => handleOpenEditModal(b)}
                  className="flex-1 flex items-center justify-center gap-1.5 py-1.5 rounded-xl bg-[#161D2B] hover:bg-[#FFC500] hover:text-black text-gray-300 text-xs font-bold transition-colors"
                >
                  <Edit3 size={13} />
                  تعديل المنشأة
                </button>
                <button
                  onClick={() => handleToggleStatus(b)}
                  className={`p-2 rounded-xl transition-colors ${
                    b.status === 'hidden'
                      ? 'bg-red-500/20 text-red-400 hover:bg-red-500/30'
                      : 'bg-[#161D2B] text-gray-400 hover:text-white'
                  }`}
                  title={b.status === 'hidden' ? 'إلغاء الإخفاء' : 'إخفاء المنشأة'}
                >
                  {b.status === 'hidden' ? <EyeOff size={14} /> : <Eye size={14} />}
                </button>
              </div>
            </div>
          ))}
        </div>
      )}

      {/* نافذة المودال الموحدة للإضافة والتعديل الكامل (طبق الأصل لنظام البنوك) */}
      {isModalOpen && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-3 sm:p-4 overflow-y-auto">
          <div className="bg-[#0F141F] border border-[#1F2937] rounded-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto shadow-2xl p-5 sm:p-6 space-y-5">
            <div className="flex items-center justify-between pb-3 border-b border-[#1F2937]">
              <h2 className="text-lg font-bold text-white flex items-center gap-2">
                <Edit3 className="text-[#FFC500]" size={18} />
                {editingId ? 'تعديل بيانات المنشأة' : 'إضافة منشأة جديدة للموقع'}
              </h2>
              <button
                onClick={() => setIsModalOpen(false)}
                className="p-1.5 text-gray-400 hover:text-white rounded-lg"
              >
                <X size={18} />
              </button>
            </div>

            {errorMessage && (
              <div className="p-3 rounded-xl bg-red-500/15 border border-red-500/30 text-red-400 text-xs">
                {errorMessage}
              </div>
            )}

            <form onSubmit={handleSaveBusiness} className="space-y-4 text-xs">
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div className="space-y-1">
                  <label className="text-gray-300 font-bold">اسم المنشأة *</label>
                  <input
                    type="text"
                    required
                    value={formData.name}
                    onChange={(e) => setFormData(p => ({ ...p, name: e.target.value }))}
                    placeholder="مثال: مطعم البيت اليمني، فندق سبأ..."
                    className="w-full p-2.5 bg-[#161D2B] border border-[#1F2937] rounded-xl text-white outline-none focus:border-[#FFC500]"
                  />
                </div>

                <div className="space-y-1">
                  <label className="text-gray-300 font-bold">التصنيف الرسمي *</label>
                  <select
                    value={formData.category_id}
                    onChange={(e) => setFormData(p => ({ ...p, category_id: e.target.value }))}
                    className="w-full p-2.5 bg-[#161D2B] border border-[#1F2937] rounded-xl text-white outline-none"
                  >
                    {OFFICIAL_CATEGORIES.map(c => {
                      const dbCat = categoriesMap[c.slug];
                      const val = dbCat ? dbCat.id : c.id;
                      return (
                        <option key={c.id} value={val}>
                          {c.name}
                        </option>
                      );
                    })}
                  </select>
                </div>
              </div>

              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div className="space-y-1">
                  <label className="text-gray-300 font-bold">المدينة / المحافظة</label>
                  <select
                    value={formData.city}
                    onChange={(e) => setFormData(p => ({ ...p, city: e.target.value }))}
                    className="w-full p-2.5 bg-[#161D2B] border border-[#1F2937] rounded-xl text-white outline-none"
                  >
                    <option value="صنعاء">صنعاء</option>
                    <option value="عدن">عدن</option>
                    <option value="تعز">تعز</option>
                    <option value="حضرموت">حضرموت</option>
                    <option value="إب">إب</option>
                    <option value="الحديدة">الحديدة</option>
                    <option value="ذمار">ذمار</option>
                    <option value="مأرب">مأرب</option>
                  </select>
                </div>

                <div className="space-y-1">
                  <label className="text-gray-300 font-bold">العنوان بالتفصيل</label>
                  <input
                    type="text"
                    value={formData.address}
                    onChange={(e) => setFormData(p => ({ ...p, address: e.target.value }))}
                    placeholder="الشارع، الحي، المعلم القريب..."
                    className="w-full p-2.5 bg-[#161D2B] border border-[#1F2937] rounded-xl text-white outline-none"
                  />
                </div>
              </div>

              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div className="space-y-1">
                  <label className="text-gray-300 font-bold">رقم الهاتف الرسمي</label>
                  <input
                    type="text"
                    value={formData.phone}
                    onChange={(e) => setFormData(p => ({ ...p, phone: e.target.value }))}
                    placeholder="+967..."
                    className="w-full p-2.5 bg-[#161D2B] border border-[#1F2937] rounded-xl text-white outline-none font-mono"
                  />
                </div>

                <div className="space-y-1">
                  <label className="text-gray-300 font-bold">رقم الواتساب</label>
                  <input
                    type="text"
                    value={formData.whatsapp}
                    onChange={(e) => setFormData(p => ({ ...p, whatsapp: e.target.value }))}
                    placeholder="+967..."
                    className="w-full p-2.5 bg-[#161D2B] border border-[#1F2937] rounded-xl text-white outline-none font-mono"
                  />
                </div>
              </div>

              {/* قسم رفع الشعار والغلاف */}
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 p-3 rounded-xl bg-[#161D2B] border border-[#1F2937]">
                <div className="space-y-2">
                  <label className="text-gray-300 font-bold block">شعار المنشأة (Logo)</label>
                  <div className="flex items-center gap-3">
                    <div className="w-12 h-12 rounded-xl bg-[#0B0F17] border border-[#1F2937] flex items-center justify-center overflow-hidden">
                      {formData.logo_url ? (
                        <img src={formData.logo_url} alt="Logo" className="w-full h-full object-cover" />
                      ) : (
                        <Building2 className="w-6 h-6 text-gray-500" />
                      )}
                    </div>
                    <label className="cursor-pointer px-3 py-1.5 rounded-xl bg-[#0B0F17] hover:bg-[#FFC500] hover:text-black text-gray-300 border border-[#1F2937] font-bold text-xs flex items-center gap-1.5 transition-colors">
                      <Upload size={13} />
                      {uploadingTarget === 'logo' ? 'جاري الرفع...' : 'رفع شعار'}
                      <input
                        type="file"
                        accept="image/*"
                        className="hidden"
                        onChange={(e) => handleUploadImage('logo', e)}
                      />
                    </label>
                  </div>
                </div>

                <div className="space-y-2">
                  <label className="text-gray-300 font-bold block">نوع الشارة (Badge)</label>
                  <select
                    value={formData.badge_type || 'none'}
                    onChange={(e) => setFormData(p => ({
                      ...p,
                      badge_type: e.target.value === 'none' ? null : (e.target.value as any)
                    }))}
                    className="w-full p-2.5 bg-[#0B0F17] border border-[#1F2937] rounded-xl text-white outline-none"
                  >
                    <option value="gold">شارة ذهبية (Gold Badge) 🏆</option>
                    <option value="blue">شارة موثقة زرقاء (Blue Verified) 🛡️</option>
                    <option value="gray">شارة فضية اعتيادية (Silver/Gray)</option>
                    <option value="none">بدون شارة (قياسي)</option>
                  </select>
                </div>
              </div>

              {/* نبذة عن المنشأة */}
              <div className="space-y-1">
                <label className="text-gray-300 font-bold">نبذة ووصف المنشأة</label>
                <textarea
                  rows={2}
                  value={formData.description}
                  onChange={(e) => setFormData(p => ({ ...p, description: e.target.value }))}
                  placeholder="وصف مختصر للخدمات والمنتجات المميزة..."
                  className="w-full p-2.5 bg-[#161D2B] border border-[#1F2937] rounded-xl text-white outline-none resize-none"
                />
              </div>

              {/* أزرار الحفظ والإلغاء */}
              <div className="flex items-center justify-end gap-3 pt-3 border-t border-[#1F2937]">
                <button
                  type="button"
                  onClick={() => setIsModalOpen(false)}
                  className="px-4 py-2 rounded-xl bg-[#161D2B] text-gray-300 hover:text-white font-bold"
                >
                  إلغاء
                </button>
                <button
                  type="submit"
                  disabled={saving}
                  className="flex items-center gap-2 px-5 py-2 rounded-xl bg-[#FFC500] hover:bg-[#e6b200] text-black font-bold shadow-lg disabled:opacity-50"
                >
                  {saving && <Loader2 className="w-4 h-4 animate-spin" />}
                  {editingId ? 'حفظ التعديلات' : 'إضافة المنشأة للموقع'}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
};
