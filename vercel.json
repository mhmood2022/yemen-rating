{
  "rewrites": [
    { "source": "/bank", "destination": "/bank.html" },
    { "source": "/banks", "destination": "/banks.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
