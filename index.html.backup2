    <!-- ═══════════════════════════════════════════
         السكربتات
    ═══════════════════════════════════════════ -->
    <script src="js/supabase.js"></script>
    <script src="js/db.js"></script>
    
    <script>
    /* ═══════════════════════════════════════════════════════════
       المنطق الرئيسي للصفحة الرئيسية
       - متوافق مع Supabase
       - يدعم كل التصنيفات السبعة
       - الوظائف مجهولة الهوية
       - 3 أماكن للإعلانات
    ═══════════════════════════════════════════════════════════ */

    (async function() {
        'use strict';
        
        let sb = null;
        
        // ═══ بدء التشغيل ═══
        async function boot() {
            try {
                sb = await getSB();
                if (!sb) throw new Error('فشل الاتصال بقاعدة البيانات');
                
                // تحميل كل الأقسام بالتوازي
                await Promise.all([
                    loadTicker(),
                    loadStats(),
                    loadCategories(),
                    loadFeaturedCompanies(),
                    loadBanks(),
                    loadShops(),
                    loadHotels(),
                    loadExchanges(),
                    loadRestaurants(),
                    loadJobs(),       // ← وظائف مجهولة الهوية
                    loadLatestReviews(),
                    loadAds()         // ← نظام الإعلانات
                ]);
                
                setupSearch();
                setupBackToTop();
                setupHeaderActions();
                
            } catch (error) {
                console.error('Boot error:', error);
                showToast('تعذر تحميل بعض البيانات', 'error');
            }
        }
        
        // ═══ شريط الأسعار (صنعاء + عدن) ═══
        async function loadTicker() {
            try {
                const [ratesRes, goldRes] = await Promise.all([
                    sb.from('exchange_rates').select('*').order('updated_at', { ascending: false }).limit(10),
                    sb.from('gold_prices').select('*').order('updated_at', { ascending: false }).limit(10)
                ]);
                
                const rates = ratesRes.data || [];
                const gold = goldRes.data || [];
                
                if (rates.length === 0 && gold.length === 0) {
                    document.getElementById('marketTicker').innerHTML = 
                        '<span class="ticker-item"><span class="label">سيتم عرض الأسعار قريباً</span></span>';
                    return;
                }
                
                let html = '';
                
                // فصل حسب المدينة
                const sanaaRates = rates.filter(r => r.city === 'صنعاء');
                const adenRates = rates.filter(r => r.city === 'عدن');
                const sanaaGold = gold.filter(g => g.city === 'صنعاء');
                const adenGold = gold.filter(g => g.city === 'عدن');
                
                // صنعاء
                if (sanaaRates.length > 0 || sanaaGold.length > 0) {
                    html += '<span class="ticker-item"><span class="city">🏙️ صنعاء</span></span>';
                    sanaaRates.forEach(r => {
                        html += `<span class="ticker-item">
                            <span class="label">${esc(r.currency)}</span>
                            <span>شراء: ${esc(r.buy_price)}</span>
                            <span>|</span>
                            <span>بيع: ${esc(r.sell_price)}</span>
                        </span>`;
                    });
                    sanaaGold.forEach(g => {
                        html += `<span class="ticker-item">
                            <span>🥇 ذهب ${esc(g.karat)}</span>
                            <span>${esc(g.price)}</span>
                        </span>`;
                    });
                }
                
                // عدن
                if (adenRates.length > 0 || adenGold.length > 0) {
                    html += '<span class="ticker-item"><span class="city">🌊 عدن</span></span>';
                    adenRates.forEach(r => {
                        html += `<span class="ticker-item">
                            <span class="label">${esc(r.currency)}</span>
                            <span>شراء: ${esc(r.buy_price)}</span>
                            <span>|</span>
                            <span>بيع: ${esc(r.sell_price)}</span>
                        </span>`;
                    });
                    adenGold.forEach(g => {
                        html += `<span class="ticker-item">
                            <span>🥇 ذهب ${esc(g.karat)}</span>
                            <span>${esc(g.price)}</span>
                        </span>`;
                    });
                }
                
                // تكرار للتمرير المستمر
                document.getElementById('marketTicker').innerHTML = html + html;
                
            } catch (error) {
                console.error('Ticker error:', error);
            }
        }
        
        // ═══ الإحصائيات السريعة ═══
        async function loadStats() {
            try {
                const [c, b, s, h, x, r, j, u] = await Promise.all([
                    sb.from('companies').select('*', { count: 'exact', head: true }).eq('status', 'ACTIVE'),
                    sb.from('banks').select('*', { count: 'exact', head: true }).eq('status', 'ACTIVE'),
                    sb.from('entities').select('*', { count: 'exact', head: true }).eq('type', 'shop').eq('status', 'ACTIVE'),
                    sb.from('entities').select('*', { count: 'exact', head: true }).eq('type', 'hotel').eq('status', 'ACTIVE'),
                    sb.from('entities').select('*', { count: 'exact', head: true }).eq('type', 'exchange').eq('status', 'ACTIVE'),
                    sb.from('entities').select('*', { count: 'exact', head: true }).eq('type', 'restaurant').eq('status', 'ACTIVE'),
                    sb.from('jobs').select('*', { count: 'exact', head: true }).eq('status', 'PUBLISHED'),
                    sb.from('profiles').select('*', { count: 'exact', head: true })
                ]);
                
                const total = (c.count||0) + (b.count||0) + (s.count||0) + (h.count||0) + (x.count||0) + (r.count||0);
                
                document.getElementById('heroStats').innerHTML = `
                    <div class="stat-pill">
                        <span class="num">${total}</span>
                        <span class="lbl">كيان مسجل</span>
                    </div>
                    <div class="stat-pill">
                        <span class="num">${j.count || 0}</span>
                        <span class="lbl">وظيفة متاحة</span>
                    </div>
                    <div class="stat-pill">
                        <span class="num">${u.count || 0}</span>
                        <span class="lbl">مستخدم</span>
                    </div>
                `;
            } catch (error) {
                // في حالة عدم وجود جدول entities، استخدم إحصائيات بديلة
                document.getElementById('heroStats').innerHTML = `
                    <div class="stat-pill">
                        <span class="num"><i class="fas fa-building"></i></span>
                        <span class="lbl">شركات وبنوك</span>
                    </div>
                    <div class="stat-pill">
                        <span class="num"><i class="fas fa-briefcase"></i></span>
                        <span class="lbl">وظائف</span>
                    </div>
                    <div class="stat-pill">
                        <span class="num"><i class="fas fa-users"></i></span>
                        <span class="lbl">مستخدمين</span>
                    </div>
                `;
            }
        }
        
        // ═══ التصنيفات ═══
        async function loadCategories() {
            const categories = [
                { id: 'company', name: 'الشركات', icon: 'fa-building', href: 'companies.html' },
                { id: 'bank', name: 'البنوك', icon: 'fa-landmark', href: 'banks.html' },
                { id: 'shop', name: 'المحلات', icon: 'fa-store', href: 'shops.html' },
                { id: 'hotel', name: 'الفنادق', icon: 'fa-hotel', href: 'hotels.html' },
                { id: 'exchange', name: 'الصرافة', icon: 'fa-money-bill-transfer', href: 'exchanges.html' },
                { id: 'restaurant', name: 'المطاعم', icon: 'fa-utensils', href: 'restaurants.html' },
                { id: 'job', name: 'الوظائف', icon: 'fa-briefcase', href: 'jobs.html' }
            ];
            
            document.getElementById('categoriesGrid').innerHTML = categories.map(cat => `
                <a href="${cat.href}" class="category-card">
                    <i class="fas ${cat.icon}"></i>
                    <h3>${esc(cat.name)}</h3>
                </a>
            `).join('');
        }
        
        // ═══ الشركات المميزة ═══
        async function loadFeaturedCompanies() {
            try {
                const { data, error } = await sb
                    .from('companies')
                    .select('*, cities(name), categories(name)')
                    .eq('status', 'ACTIVE')
                    .or('is_verified.eq.true,package.eq.gold,package.eq.diamond')
                    .limit(4);
                
                if (error) throw error;
                
                renderEntities('featuredCompanies', data || [], 'company');
            } catch (error) {
                document.getElementById('featuredCompanies').innerHTML = 
                    '<div class="empty-state"><i class="fas fa-building"></i><p>لا توجد شركات مميزة حالياً</p></div>';
            }
        }
        
        // ═══ البنوك ═══
        async function loadBanks() {
            try {
                const { data, error } = await sb
                    .from('banks')
                    .select('*, cities(name)')
                    .eq('status', 'ACTIVE')
                    .limit(4);
                
                if (error) throw error;
                
                renderEntities('latestBanks', data || [], 'bank');
            } catch (error) {
                document.getElementById('latestBanks').innerHTML = 
                    '<div class="empty-state"><i class="fas fa-landmark"></i><p>لا توجد بنوك مسجلة</p></div>';
            }
        }
        
        // ═══ المحلات التجارية ═══
        async function loadShops() {
            try {
                const { data, error } = await sb
                    .from('entities')
                    .select('*, cities(name)')
                    .eq('type', 'shop')
                    .eq('status', 'ACTIVE')
                    .limit(4);
                
                if (error) throw error;
                
                renderEntities('latestShops', data || [], 'shop');
            } catch (error) {
                document.getElementById('latestShops').innerHTML = 
                    '<div class="empty-state"><i class="fas fa-store"></i><p>لا توجد محلات مسجلة</p></div>';
            }
        }
        
        // ═══ الفنادق ═══
        async function loadHotels() {
            try {
                const { data, error } = await sb
                    .from('entities')
                    .select('*, cities(name)')
                    .eq('type', 'hotel')
                    .eq('status', 'ACTIVE')
                    .limit(4);
                
                if (error) throw error;
                
                renderEntities('latestHotels', data || [], 'hotel');
            } catch (error) {
                document.getElementById('latestHotels').innerHTML = 
                    '<div class="empty-state"><i class="fas fa-hotel"></i><p>لا توجد فنادق مسجلة</p></div>';
            }
        }
        
        // ═══ محلات الصرافة ═══
        async function loadExchanges() {
            try {
                const { data, error } = await sb
                    .from('entities')
                    .select('*, cities(name)')
                    .eq('type', 'exchange')
                    .eq('status', 'ACTIVE')
                    .limit(4);
                
                if (error) throw error;
                
                renderEntities('latestExchanges', data || [], 'exchange');
            } catch (error) {
                document.getElementById('latestExchanges').innerHTML = 
                    '<div class="empty-state"><i class="fas fa-money-bill-transfer"></i><p>لا توجد محلات صرافة مسجلة</p></div>';
            }
        }
        
        // ═══ المطاعم ═══
        async function loadRestaurants() {
            try {
                const { data, error } = await sb
                    .from('entities')
                    .select('*, cities(name)')
                    .eq('type', 'restaurant')
                    .eq('status', 'ACTIVE')
                    .limit(4);
                
                if (error) throw error;
                
                renderEntities('latestRestaurants', data || [], 'restaurant');
            } catch (error) {
                document.getElementById('latestRestaurants').innerHTML = 
                    '<div class="empty-state"><i class="fas fa-utensils"></i><p>لا توجد مطاعم مسجلة</p></div>';
            }
        }
        
        // ═══ عرض الكيانات (دالة موحدة) ═══
        function renderEntities(containerId, items, type) {
            const container = document.getElementById(containerId);
            
            if (!items || items.length === 0) {
                const icons = {
                    company: 'fa-building', bank: 'fa-landmark',
                    shop: 'fa-store', hotel: 'fa-hotel',
                    exchange: 'fa-money-bill-transfer', restaurant: 'fa-utensils'
                };
                container.innerHTML = `
                    <div class="empty-state">
                        <i class="fas ${icons[type] || 'fa-tag'}"></i>
                        <p>لا توجد عناصر مسجلة حالياً</p>
                    </div>
                `;
                return;
            }
            
            container.innerHTML = items.map(item => {
                const href = getEntityHref(item, type);
                const badge = item.is_verified 
                    ? '<span class="badge-verified"><i class="fas fa-check-circle"></i> موثق</span>' 
                    : '';
                const packageBadge = item.package === 'gold' 
                    ? '<span class="badge-gold">⭐ مميز</span>' 
                    : item.package === 'silver' 
                        ? '<span class="badge-silver">فضي</span>' 
                        : item.package === 'bronze' 
                            ? '<span class="badge-bronze">برونزي</span>' 
                            : '';
                
                const coverStyle = item.cover_url 
                    ? `<img src="${esc(item.cover_url)}" alt="${esc(item.name)}">`
                    : `<i class="fas ${getIconForType(type)} placeholder"></i>`;
                
                const logoStyle = item.logo_url 
                    ? `<img src="${esc(item.logo_url)}" alt="${esc(item.name)}">`
                    : `<i class="fas ${getIconForType(type)}"></i>`;
                
                return `
                    <a href="${href}" class="entity-card" style="text-decoration:none; color:inherit;">
                        <div class="entity-cover">
                            ${coverStyle}
                            <div class="entity-logo">${logoStyle}</div>
                        </div>
                        <div class="entity-body">
                            <div class="entity-name">
                                ${esc(item.name)}
                                ${badge}
                                ${packageBadge}
                            </div>
                            <div class="entity-desc">${esc(item.description || '')}</div>
                            <div class="entity-meta">
                                ${item.cities ? `<span><i class="fas fa-map-marker-alt"></i> ${esc(item.cities.name)}</span>` : ''}
                                ${item.stars ? `<span>⭐ ${item.stars}</span>` : ''}
                            </div>
                        </div>
                    </a>
                `;
            }).join('');
        }
        
        function getEntityHref(item, type) {
            const map = {
                company: 'company.html',
                bank: 'bank.html',
                shop: 'entity.html?type=shop',
                hotel: 'entity.html?type=hotel',
                exchange: 'entity.html?type=exchange',
                restaurant: 'entity.html?type=restaurant'
            };
            const base = map[type] || 'entity.html';
            return `${base}?id=${item.id}`;
        }
        
        function getIconForType(type) {
            const icons = {
                company: 'fa-building', bank: 'fa-landmark',
                shop: 'fa-store', hotel: 'fa-hotel',
                exchange: 'fa-money-bill-transfer', restaurant: 'fa-utensils'
            };
            return icons[type] || 'fa-tag';
        }
        
        // ═══ الوظائف (مجهولة الهوية تماماً) ═══
        async function loadJobs() {
            try {
                const { data, error } = await sb
                    .from('jobs')
                    .select('*')
                    .eq('status', 'PUBLISHED')  // فقط المنشورة من الإدارة
                    .order('created_at', { ascending: false })
                    .limit(6);
                
                if (error) throw error;
                
                const jobs = data || [];
                const container = document.getElementById('latestJobs');
                
                if (jobs.length === 0) {
                    container.innerHTML = `
                        <div class="empty-state">
                            <i class="fas fa-briefcase"></i>
                            <p>لا توجد وظائف متاحة حالياً</p>
                        </div>
                    `;
                    return;
                }
                
                // ⚠️ مهم جداً: لا نعرض اسم الشركة أو أي معلومات تدل على هويتها
                container.innerHTML = jobs.map(job => {
                    const typeClass = job.type === 'full-time' ? 'full' 
                                    : job.type === 'part-time' ? 'part' 
                                    : 'remote';
                    const typeLabel = job.type === 'full-time' ? 'دوام كامل'
                                    : job.type === 'part-time' ? 'دوام جزئي'
                                    : job.type === 'remote' ? 'عن بُعد'
                                    : job.type || 'غير محدد';
                    
                    const deadline = job.deadline 
                        ? `<span><i class="fas fa-calendar"></i> آخر موعد: ${formatDate(job.deadline)}</span>`
                        : '';
                    
                    return `
                        <a href="job.html?id=${job.id}" class="job-card" style="text-decoration:none; color:inherit;">
                            <div class="job-header">
                                <div class="job-title">${esc(job.title)}</div>
                                <span class="job-type ${typeClass}">${esc(typeLabel)}</span>
                            </div>
                            <div class="job-meta">
                                ${job.city ? `<span><i class="fas fa-map-marker-alt"></i> ${esc(job.city)}</span>` : ''}
                                ${job.salary ? `<span><i class="fas fa-money-bill-wave"></i> ${esc(job.salary)}</span>` : ''}
                                ${deadline}
                            </div>
                            <div class="job-anonymous">
                                <i class="fas fa-lock"></i>
                                <span>التقديم عبر منصة يمن ريتنج • هوية الناشر مخفية</span>
                            </div>
                        </a>
                    `;
                }).join('');
                
            } catch (error) {
                document.getElementById('latestJobs').innerHTML = 
                    '<div class="empty-state"><i class="fas fa-briefcase"></i><p>لا توجد وظائف حالياً</p></div>';
            }
        }
        
        // ═══ آخر التقييمات ═══
        async function loadLatestReviews() {
            try {
                const { data, error } = await sb
                    .from('reviews')
                    .select('*')
                    .eq('status', 'APPROVED')  // فقط الموافق عليها
                    .order('created_at', { ascending: false })
                    .limit(3);
                
                if (error) throw error;
                
                const reviews = data || [];
                const container = document.getElementById('latestReviews');
                
                if (reviews.length === 0) {
                    container.innerHTML = `
                        <div class="empty-state">
                            <i class="fas fa-star"></i>
                            <p>لا توجد تقييمات بعد - كن الأول!</p>
                        </div>
                    `;
                    return;
                }
                
                container.innerHTML = reviews.map(review => {
                    const stars = '★'.repeat(review.rating || review.stars || 5) + 
                                 '☆'.repeat(5 - (review.rating || review.stars || 5));
                    
                    return `
                        <div class="review-card">
                            <div class="review-header">
                                <div class="review-avatar">
                                    ${(review.user_name || 'م').charAt(0)}
                                </div>
                                <div class="review-meta">
                                    <div class="review-name">${esc(review.user_name || 'مستخدم')}</div>
                                    <div class="review-target">على: ${esc(review.entity_name || 'كيان')}</div>
                                    <div class="review-date">${formatDate(review.created_at)}</div>
                                </div>
                            </div>
                            <div style="color:var(--gold-400); margin-bottom:8px; letter-spacing:2px;">
                                ${stars}
                            </div>
                            <div class="review-comment">
                                ${esc(review.comment || review.text || '')}
                            </div>
                        </div>
                    `;
                }).join('');
                
            } catch (error) {
                document.getElementById('latestReviews').innerHTML = 
                    '<div class="empty-state"><i class="fas fa-star"></i><p>لا توجد تقييمات بعد</p></div>';
            }
        }
        
        // ═══ نظام الإعلانات ═══
        async function loadAds() {
            try {
                const placements = ['homepage_top', 'homepage_middle', 'homepage_bottom'];
                
                const { data, error } = await sb
                    .from('advertisements')
                    .select('*')
                    .in('placement', placements)
                    .eq('status', 'ACTIVE')
                    .lte('start_date', new Date().toISOString())
                    .gte('end_date', new Date().toISOString())
                    .order('priority', { ascending: false });
                
                if (error || !data) return;
                
                data.forEach(ad => {
                    const slot = document.getElementById('ad_' + ad.placement);
                    if (!slot) return;
                    
                    // تسجيل ظهور الإعلان
                    logAdEvent(ad.id, 'impression');
                    
                    let content = '';
                    if (ad.type === 'image' && ad.image_url) {
                        content = `<a href="${esc(ad.target_url || '#')}" target="_blank" onclick="logAdEvent('${ad.id}', 'click')">
                            <img src="${esc(ad.image_url)}" alt="${esc(ad.title || 'إعلان')}">
                        </a>`;
                    } else if (ad.type === 'html' && ad.html_content) {
                        content = ad.html_content;
                    } else {
                        content = `<a href="${esc(ad.target_url || '#')}" target="_blank" onclick="logAdEvent('${ad.id}', 'click')" style="color:var(--gold-400); font-weight:700;">
                            ${esc(ad.title || 'إعلان')}
                        </a>`;
                    }
                    
                    slot.innerHTML = content;
                    slot.style.border = 'none';
                    slot.style.background = 'transparent';
                    slot.style.padding = '0';
                });
                
            } catch (error) {
                // الإعلانات اختيارية - لا نعرض خطأ
                console.log('Ads not loaded:', error.message);
            }
        }
        
        async function logAdEvent(adId, eventType) {
            try {
                await sb.from('ad_events').insert({
                    advertisement_id: adId,
                    event_type: eventType,
                    user_agent: navigator.userAgent,
                    ip_address: null  // سيتم تعبئته من الخادم
                });
            } catch (e) { /* تجاهل */ }
        }
        
        // ═══ البحث ═══
        function setupSearch() {
            const input = document.getElementById('mainSearch');
            const btn = document.querySelector('.search-box .btn');
            
            if (input) {
                input.addEventListener('keyup', e => {
                    if (e.key === 'Enter') doSearch();
                });
            }
        }
        
        window.doSearch = function() {
            const term = (document.getElementById('mainSearch').value || '').trim();
            if (!term) {
                showToast('اكتب كلمة للبحث', 'error');
                return;
            }
            window.location.href = 'search.html?q=' + encodeURIComponent(term);
        };
        
        // ═══ زر العودة للأعلى ═══
        function setupBackToTop() {
            const btn = document.getElementById('backToTop');
            if (!btn) return;
            
            window.addEventListener('scroll', () => {
                btn.classList.toggle('visible', window.scrollY > 400);
            });
            
            btn.addEventListener('click', () => {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        }
        
        // ═══ إجراءات الهيدر (تسجيل دخول/خروج) ═══
        async function setupHeaderActions() {
            const container = document.getElementById('headerActions');
            if (!container) return;
            
            try {
                const { data: { session } } = await sb.auth.getSession();
                
                if (session && session.user) {
                    // جلب بيانات المستخدم
                    const { data: profile } = await sb
                        .from('profiles')
                        .select('full_name, role')
                        .eq('id', session.user.id)
                        .single();
                    
                    const name = profile?.full_name || session.user.email.split('@')[0];
                    
                    container.innerHTML = `
                        <span style="color:var(--gold-400); font-weight:700; margin-left:10px;">
                            <i class="fas fa-user-circle"></i> ${esc(name)}
                        </span>
                        <button class="btn btn-outline" onclick="logout()" style="padding:8px 16px;">
                            <i class="fas fa-sign-out-alt"></i> خروج
                        </button>
                    `;
                } else {
                    container.innerHTML = `
                        <a href="login.html" class="btn btn-outline" style="padding:8px 16px;">
                            <i class="fas fa-sign-in-alt"></i> دخول
                        </a>
                        <a href="register.html" class="btn btn-gold" style="padding:8px 16px;">
                            <i class="fas fa-user-plus"></i> حساب جديد
                        </a>
                    `;
                }
            } catch (error) {
                // في حالة الفشل، اعرض أزرار الدخول
                container.innerHTML = `
                    <a href="login.html" class="btn btn-outline" style="padding:8px 16px;">دخول</a>
                    <a href="register.html" class="btn btn-gold" style="padding:8px 16px;">حساب جديد</a>
                `;
            }
        }
        
        window.logout = async function() {
            try {
                await sb.auth.signOut();
                showToast('تم تسجيل الخروج', 'success');
                setTimeout(() => location.reload(), 500);
            } catch (error) {
                showToast('حدث خطأ', 'error');
            }
        };
        
        // ═══ دوال مساعدة ═══
        function esc(str) {
            if (!str) return '';
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }
        
        function formatDate(dateStr) {
            if (!dateStr) return '';
            try {
                return new Date(dateStr).toLocaleDateString('ar-YE');
            } catch {
                return dateStr;
            }
        }
        
        function showToast(msg, type = 'info') {
            const toast = document.createElement('div');
            toast.style.cssText = `
                position: fixed; top: 20px; left: 20px;
                background: ${type === 'error' ? 'var(--danger)' : 'var(--navy-700)'};
                border: 1px solid var(--gold-500);
                color: #fff;
                padding: 15px 25px;
                border-radius: 10px;
                z-index: 9999;
                box-shadow: 0 5px 20px rgba(0,0,0,0.3);
                animation: slideIn 0.3s;
                font-family: 'Cairo', sans-serif;
            `;
            toast.textContent = msg;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }
        
        // ═══ بدء التشغيل ═══
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', boot);
        } else {
            boot();
        }
        
    })();
    </script>
</body>
</html>
